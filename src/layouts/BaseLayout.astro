---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/source-serif-4/400.css';
import '../styles/tokens.css';

interface Props {
  title: string;
}

const { title } = Astro.props;

const nav = [
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/performance', label: 'Performance' },
  { href: '/research', label: 'Research' },
  { href: '/journal', label: 'Journal' },
  { href: '/method', label: 'Method' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      try {
        const stored = localStorage.getItem('theme');
        if (stored) document.documentElement.dataset.theme = stored;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href="/">Portfolio</a>
      <nav>
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        General information only, not personal advice. This site isn't provided under an
        Australian financial services licence. I own the investments discussed. High risk.
        <a href="/disclaimer">Full disclaimer</a>
      </p>
      <p>
        <a href="/">View the ledger</a>
      </p>
    </footer>
  </body>
</html>

<style>
  .site-header,
  .site-footer {
    max-width: var(--table-max);
    margin: 0 auto;
    padding: 1rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--rule);
  }

  .site-footer {
    border-bottom: none;
    border-top: 1px solid var(--rule);
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .site-name {
    font-weight: 600;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 1.25rem;
  }

  nav a {
    text-decoration: none;
    color: var(--ink);
  }

  main {
    max-width: var(--table-max);
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }
</style>
