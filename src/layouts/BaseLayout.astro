---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/source-serif-4/400.css';
import '../styles/tokens.css';
import { formatDate } from '../lib/format';
import { getStatus } from '../lib/data';
import { url } from '../lib/url';

interface Props {
  title: string;
}

const { title } = Astro.props;
const status = getStatus();

const SITE_NAME = 'AlphaSeek';
const REPO_URL = 'https://github.com/dreamscraper12/AlphaSeek';

const nav = [
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/performance', label: 'Performance' },
  { href: '/research', label: 'Research' },
  { href: '/journal', label: 'Journal' },
  { href: '/method', label: 'Method' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === SITE_NAME ? title : `${title} — ${SITE_NAME}`}</title>
    <script is:inline>
      try {
        const stored = localStorage.getItem('theme');
        if (stored) document.documentElement.dataset.theme = stored;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="site-name" href={url("/")}>AlphaSeek</a>
      <nav aria-label="Primary">
        {
          nav.map((item) => (
            <a
              href={url(item.href)}
              class:list={['nav-link', { current: path === url(item.href) }]}
              aria-current={path === url(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p class="disclaimer">
        General information only, not personal advice. This site isn't provided under an
        Australian financial services licence. I own the investments discussed. High risk.
        <a href={url("/disclaimer")}>Full disclaimer</a>
      </p>
      <p class="meta">
        <span>
          Last valued {
            status.last_valuation_date ? formatDate(status.last_valuation_date) : 'not yet run'
          }
        </span>
        <a href={REPO_URL}>View the ledger</a>
      </p>
    </footer>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: var(--space-2);
    background: var(--bg);
    color: var(--ink);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--rule);
  }

  .skip-link:focus {
    left: var(--space-4);
    z-index: 1;
  }

  .site-header {
    max-width: var(--table-max);
    margin: 0 auto;
    padding: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    border-bottom: 1px solid var(--rule);
  }

  .site-name {
    font-weight: 600;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: var(--text-sm);
  }

  .nav-link {
    color: var(--muted);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link.current {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  main {
    max-width: var(--table-max);
    margin: 0 auto;
    padding: var(--space-7) var(--space-4) var(--space-8);
  }

  .site-footer {
    max-width: var(--table-max);
    margin: 0 auto;
    padding: var(--space-4) var(--space-4) var(--space-7);
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .site-footer p {
    margin: 0 0 var(--space-2);
  }

  .disclaimer {
    max-width: var(--measure);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
  }
</style>
