---
import BaseLayout from '../layouts/BaseLayout.astro';
import HoldingsTable from '../components/HoldingsTable.astro';
import { formatCurrency, formatSignedCurrency } from '../lib/format';
import { getHoldings, getClosedPositions, getStatus } from '../lib/data';
import { url } from '../lib/url';

const holdings = getHoldings();
const closed = getClosedPositions();
const status = getStatus();
const cashEntries = Object.entries(status.cash_by_currency);
---

<BaseLayout title="Portfolio holdings">
  <h1>Portfolio</h1>

  <h2>Open positions</h2>
  <HoldingsTable holdings={holdings} />
  {
    status.stale_prices.length > 0 && (
      <p class="note">
        Priced from the last available close: {status.stale_prices.join(', ')}.
      </p>
    )
  }

  <h2>Cash</h2>
  {
    cashEntries.length === 0 ? (
      <p class="note">No cash recorded yet.</p>
    ) : (
      <table class="data-table narrow">
        <thead>
          <tr>
            <th scope="col">Currency</th>
            <th scope="col">Balance</th>
          </tr>
        </thead>
        <tbody>
          {cashEntries.map(([currency, amount]) => (
            <tr>
              <td>{currency}</td>
              <td class="numeric">
                {formatCurrency(amount, currency === 'USD' ? 'USD' : 'AUD')}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }

  <h2>Closed positions</h2>
  <p class="note">Closed and losing positions stay here permanently.</p>
  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th scope="col">Instrument</th>
          <th scope="col">Type</th>
          <th scope="col">Realised P&L (A$)</th>
        </tr>
      </thead>
      <tbody>
        {
          closed.map((c) => (
            <tr>
              <td>
                {c.note_slug ? (
                  <a href={url(`/research/${c.note_slug}`)}>{c.instrument_id}</a>
                ) : (
                  c.instrument_id
                )}
              </td>
              <td class="type">{c.type}</td>
              <td class:list={['numeric', c.realised_pnl < 0 ? 'loss' : 'gain']}>
                {formatSignedCurrency(c.realised_pnl, 'AUD')}
              </td>
            </tr>
          ))
        }
        {
          closed.length === 0 && (
            <tr>
              <td class="empty" colspan="3">
                No closed positions yet.
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
  </div>
</BaseLayout>

<style>
  .note {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .type {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .narrow {
    max-width: 24rem;
  }
</style>
