---
import BaseLayout from '../layouts/BaseLayout.astro';
import EquityCurve from '../components/EquityCurve.astro';
import { formatDate, formatSignedPercent } from '../lib/format';
import { getNavDaily, getBenchmarkDaily, getMetrics, getAttribution } from '../lib/data';
import type { PeriodReturns } from '../lib/data';

const navSeries = getNavDaily();
const benchmarkSeries = getBenchmarkDaily();
const metrics = getMetrics();
const attribution = getAttribution();

const PERIODS: { key: keyof PeriodReturns; label: string }[] = [
  { key: '1M', label: '1 month' },
  { key: '3M', label: '3 months' },
  { key: 'YTD', label: 'Year to date' },
  { key: '1Y', label: '1 year' },
  { key: 'since_inception', label: 'Since inception' },
];

function pct(value: number | null): string {
  return value === null ? '—' : formatSignedPercent(value);
}

function ratio(value: number | null): string {
  return value === null ? '—' : value.toFixed(2);
}

const contributionByInstrument = new Map<string, number>();
for (const row of attribution) {
  contributionByInstrument.set(
    row.instrument_id,
    (contributionByInstrument.get(row.instrument_id) ?? 0) + row.contribution,
  );
}
const contributionRows = [...contributionByInstrument.entries()].sort((a, b) => b[1] - a[1]);

function label(instrumentId: string): string {
  return instrumentId === 'CASH_AND_FX' ? 'Cash & FX' : instrumentId;
}

const portfolio = metrics.portfolio;
const benchmark = metrics.benchmark;
---

<BaseLayout title="Performance">
  <h1>Performance</h1>

  <EquityCurve portfolio={navSeries} benchmark={benchmarkSeries} />

  <h2>Returns</h2>
  {
    portfolio === null || benchmark === null ? (
      <p class="note">Not enough history yet to compute returns.</p>
    ) : (
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Period</th>
              <th scope="col">Portfolio (%)</th>
              <th scope="col">Benchmark (%)</th>
            </tr>
          </thead>
          <tbody>
            {PERIODS.map((p) => (
              <tr>
                <td>{p.label}</td>
                <td class="numeric accent">{pct(portfolio.returns[p.key])}</td>
                <td class="numeric muted">{pct(benchmark.returns[p.key])}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  <h2>Risk</h2>
  {
    portfolio === null ? (
      <p class="note">Not enough history yet to compute risk metrics.</p>
    ) : (
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Metric</th>
              <th scope="col">Portfolio</th>
              <th scope="col">Benchmark</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Annualised return</td>
              <td class="numeric accent">{pct(portfolio.annualised_return)}</td>
              <td class="numeric muted">{pct(benchmark?.annualised_return ?? null)}</td>
            </tr>
            <tr>
              <td>Annualised volatility</td>
              <td class="numeric accent">{pct(portfolio.annualised_volatility)}</td>
              <td class="numeric muted">{pct(benchmark?.annualised_volatility ?? null)}</td>
            </tr>
            <tr>
              <td>Current drawdown</td>
              <td class="numeric accent">{pct(portfolio.current_drawdown)}</td>
              <td class="numeric muted">{pct(benchmark?.current_drawdown ?? null)}</td>
            </tr>
            <tr>
              <td>
                Max drawdown
                {portfolio.max_drawdown && (
                  <span class="when">
                    {formatDate(portfolio.max_drawdown.peak_date)} to{' '}
                    {formatDate(portfolio.max_drawdown.trough_date)}
                  </span>
                )}
              </td>
              <td class="numeric accent">
                {portfolio.max_drawdown ? pct(portfolio.max_drawdown.drawdown) : '—'}
              </td>
              <td class="numeric muted">
                {benchmark?.max_drawdown ? pct(benchmark.max_drawdown.drawdown) : '—'}
              </td>
            </tr>
            <tr>
              <td>Beta to benchmark</td>
              <td class="numeric accent">{ratio(portfolio.beta)}</td>
              <td class="numeric muted">—</td>
            </tr>
            <tr>
              <td>Correlation to benchmark</td>
              <td class="numeric accent">{ratio(portfolio.correlation)}</td>
              <td class="numeric muted">—</td>
            </tr>
            <tr>
              <td>Excess return since inception</td>
              <td class="numeric accent">{pct(portfolio.excess_return)}</td>
              <td class="numeric muted">—</td>
            </tr>
          </tbody>
        </table>
      </div>
    )
  }

  <h2>Attribution</h2>
  <p class="note">Cumulative contribution to return since inception, by holding.</p>
  {
    contributionRows.length === 0 ? (
      <p class="note">Not enough history yet to compute attribution.</p>
    ) : (
      <table class="data-table narrow">
        <thead>
          <tr>
            <th scope="col">Holding</th>
            <th scope="col">Contribution (%)</th>
          </tr>
        </thead>
        <tbody>
          {contributionRows.map(([instrumentId, contribution]) => (
            <tr>
              <td>{label(instrumentId)}</td>
              <td class:list={['numeric', contribution < 0 ? 'loss' : 'gain']}>
                {formatSignedPercent(contribution)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }

  <p class="note">
    Beta and correlation need at least 60 daily observations. Full methodology: see the{' '}
    <a href="/method">Method</a> page.
  </p>
</BaseLayout>

<style>
  .note {
    color: var(--muted);
    font-size: var(--text-sm);
    max-width: var(--measure);
  }

  /* The portfolio's own column carries the accent; the benchmark stays
     neutral grey (CLAUDE.md section 16). */
  .accent {
    color: var(--accent);
  }

  .when {
    display: block;
    color: var(--muted);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .narrow {
    max-width: 30rem;
  }
</style>
