---
import BaseLayout from '../layouts/BaseLayout.astro';
import EquityCurve from '../components/EquityCurve.astro';
import HoldingsTable from '../components/HoldingsTable.astro';
import { formatCurrencyWhole, formatDate } from '../lib/format';
import { getNavDaily, getBenchmarkDaily, getHoldings, getStatus, getTrades } from '../lib/data';

const status = getStatus();
const navSeries = getNavDaily();
const benchmarkSeries = getBenchmarkDaily();
const holdings = getHoldings();
const trades = getTrades().slice(0, 5);

const latestNav = navSeries.at(-1) ?? null;
const latestBenchmark = benchmarkSeries.at(-1) ?? null;
const deposit = status.inception_deposit;
const inception = status.inception_date;
---

<BaseLayout title="Portfolio">
  <div class="hero">
    {
      latestNav && deposit !== null && inception ? (
        <>
          <p class="headline">
            {formatCurrencyWhole(deposit, 'AUD')} invested on {formatDate(inception)} is now worth{' '}
            <span class="figure">{formatCurrencyWhole(latestNav.nav, 'AUD')}</span>.
          </p>
          {latestBenchmark && (
            <p class="headline-sub">
              The same amount in the S&P 500 is worth {formatCurrencyWhole(latestBenchmark.nav, 'AUD')}.
            </p>
          )}
        </>
      ) : (
        <p class="headline">
          No valuation history yet. The record starts with the inception deposit.
        </p>
      )
    }
  </div>

  <EquityCurve portfolio={navSeries} benchmark={benchmarkSeries} />

  <div class="columns">
    <section>
      <h2>Holdings</h2>
      <HoldingsTable holdings={holdings} compact />
    </section>

    <section>
      <h2>Latest</h2>
      <ul class="trade-list">
        {
          trades.map((t) => (
            <li>
              <span class="when">{formatDate(t.executed_at)}</span>
              <span>
                {t.side === 'BUY' ? 'Bought' : 'Sold'} {t.instrument_id}
              </span>
            </li>
          ))
        }
        {trades.length === 0 && <li class="muted">No trades recorded yet.</li>}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    margin-bottom: var(--space-6);
  }

  .headline {
    font-size: var(--text-lg);
    line-height: 1.3;
    letter-spacing: -0.015em;
    margin-bottom: var(--space-2);
  }

  .headline .figure {
    color: var(--accent);
  }

  .headline-sub {
    color: var(--muted);
    margin-bottom: 0;
  }

  .columns {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  @media (min-width: 720px) {
    .columns {
      grid-template-columns: 3fr 2fr;
      gap: var(--space-7);
    }
  }

  /* The section rule from the base styles reads as a divider between the
     two columns at wide sizes, so keep it, but drop the extra top space. */
  .columns h2 {
    margin-top: 0;
  }

  .trade-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--text-sm);
  }

  .trade-list li {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--rule);
  }

  .when {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.9em;
    white-space: nowrap;
  }
</style>
