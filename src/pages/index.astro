---
import BaseLayout from '../layouts/BaseLayout.astro';
import EquityCurve from '../components/EquityCurve.astro';
import HoldingsTable from '../components/HoldingsTable.astro';
import { formatCurrency, formatDate } from '../lib/format';
import { getNavDaily, getBenchmarkDaily, getHoldings, getStatus, getTrades } from '../lib/data';

const status = getStatus();
const navSeries = getNavDaily();
const benchmarkSeries = getBenchmarkDaily();
const holdings = getHoldings();
const trades = getTrades().slice(0, 5);

const latestNav = navSeries.at(-1) ?? null;
const latestBenchmark = benchmarkSeries.at(-1) ?? null;
---

<BaseLayout title="Portfolio">
  <p class="headline">
    {
      latestNav
        ? `A$10,000 is now worth ${formatCurrency(latestNav.nav, 'AUD')}.`
        : 'No valuation history yet — the ledger currently holds only the inception deposit.'
    }
  </p>
  {
    latestBenchmark && (
      <p class="headline-sub">
        The same amount in the S&P 500 is worth {formatCurrency(latestBenchmark.nav, 'AUD')}.
      </p>
    )
  }

  <EquityCurve portfolio={navSeries} benchmark={benchmarkSeries} />

  <h2>Holdings</h2>
  <HoldingsTable holdings={holdings} compact />

  <h2>Latest trades</h2>
  <ul class="trade-list">
    {trades.map((t) => <li>{formatDate(t.executed_at)} — {t.side === 'BUY' ? 'Bought' : 'Sold'} {t.instrument_id}</li>)}
    {trades.length === 0 && <li>No trades recorded yet.</li>}
  </ul>

  <p class="last-valued">
    Last valued {status.last_valuation_date ? formatDate(status.last_valuation_date) : 'not yet run'}
  </p>
</BaseLayout>

<style>
  .headline {
    font-size: 1.375rem;
    max-width: var(--measure);
  }

  .headline-sub {
    color: var(--muted);
    max-width: var(--measure);
  }

  .trade-list {
    padding-left: 1.25rem;
  }

  .last-valued {
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
