---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/format';

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.published_at.getTime() - a.data.published_at.getTime(),
);
---

<BaseLayout title="Research">
  <h1>Research</h1>
  <ul class="notes-list">
    {
      notes.map((note) => (
        <li>
          <a href={`/research/${note.id}`}>{note.data.title}</a>
          <span class="meta">
            {formatDate(note.data.published_at)} — {note.data.status}
          </span>
        </li>
      ))
    }
    {notes.length === 0 && <li>No notes published yet.</li>}
  </ul>
</BaseLayout>

<style>
  .notes-list {
    list-style: none;
    padding: 0;
  }

  .notes-list li {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .meta {
    display: block;
    color: var(--muted);
    font-size: 0.8125rem;
  }
</style>
