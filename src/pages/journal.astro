---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatCurrency, formatDate } from '../lib/format';
import { getTrades } from '../lib/data';

const trades = getTrades();
---

<BaseLayout title="Journal">
  <h1>Journal</h1>
  <p class="note">Every trade, newest first, as recorded in the ledger.</p>

  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          <th scope="col">Date</th>
          <th scope="col">Instrument</th>
          <th scope="col">Side</th>
          <th scope="col">Quantity</th>
          <th scope="col">Price</th>
        </tr>
      </thead>
      <tbody>
        {
          trades.map((t) => (
            <tr>
              <td class="numeric when">{formatDate(t.executed_at)}</td>
              <td>
                {t.note_slug ? (
                  <a href={`/research/${t.note_slug}`}>{t.instrument_id}</a>
                ) : (
                  t.instrument_id
                )}
              </td>
              <td class="side">{t.side === 'BUY' ? 'Bought' : 'Sold'}</td>
              <td class="numeric">{t.quantity}</td>
              <td class="numeric">{formatCurrency(t.price, t.currency)}</td>
            </tr>
          ))
        }
        {
          trades.length === 0 && (
            <tr>
              <td class="empty" colspan="5">
                No trades recorded yet.
              </td>
            </tr>
          )
        }
      </tbody>
    </table>
  </div>
</BaseLayout>

<style>
  .note {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  /* Specific enough to beat the shared first-column rule, which allows
     wrapping for long instrument names. */
  td.when {
    color: var(--muted);
    white-space: nowrap;
  }

  .side {
    color: var(--muted);
    font-size: var(--text-sm);
  }
</style>
