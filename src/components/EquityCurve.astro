---
import { formatCurrencyWhole, formatDate } from '../lib/format';
import type { NavPoint } from '../lib/data';

interface Props {
  portfolio: NavPoint[];
  benchmark: NavPoint[];
}

const { portfolio, benchmark } = Astro.props;
const hasData = portfolio.length > 1;
const chartData = JSON.stringify({ portfolio, benchmark });
---

<figure class="equity-curve">
  {
    hasData ? (
      <div id="equity-chart" data-series={chartData} />
    ) : (
      <p class="empty">Not enough history yet to draw a chart.</p>
    )
  }

  <figcaption>
    <details>
      <summary>Table of values</summary>
      <div class="table-scroll">
        <table class="data-table">
          <caption class="visually-hidden">Portfolio value versus benchmark, by date</caption>
          <thead>
            <tr>
              <th scope="col">Date</th>
              <th scope="col">Portfolio (A$)</th>
              <th scope="col">Benchmark (A$)</th>
            </tr>
          </thead>
          <tbody>
            {portfolio.map((p, i) => (
              <tr>
                <td>{formatDate(p.date)}</td>
                <td class="numeric accent">{formatCurrencyWhole(p.nav, 'AUD')}</td>
                <td class="numeric muted">
                  {benchmark[i] ? formatCurrencyWhole(benchmark[i].nav, 'AUD') : '—'}
                </td>
              </tr>
            ))}
            {portfolio.length === 0 && (
              <tr>
                <td class="empty" colspan="3">
                  No valuation history yet.
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </details>
  </figcaption>
</figure>

<script>
  import uPlot from 'uplot';
  import 'uplot/dist/uPlot.min.css';

  const el = document.getElementById('equity-chart');
  if (el) {
    const { portfolio, benchmark } = JSON.parse(el.dataset.series ?? '{}') as {
      portfolio: { date: string; nav: number }[];
      benchmark: { date: string; nav: number }[];
    };

    const x = portfolio.map((p) => new Date(p.date).getTime() / 1000);
    const styles = getComputedStyle(document.documentElement);
    const accent = styles.getPropertyValue('--accent').trim() || '#2346a0';
    const muted = styles.getPropertyValue('--muted').trim() || '#5e6875';
    const rule = styles.getPropertyValue('--rule').trim() || '#e2e5ea';

    new uPlot(
      {
        width: el.clientWidth || 640,
        height: 300,
        padding: [8, 8, 0, 0],
        legend: { show: false },
        axes: [
          { stroke: muted, grid: { stroke: rule, width: 1 }, ticks: { stroke: rule } },
          { stroke: muted, grid: { stroke: rule, width: 1 }, ticks: { stroke: rule } },
        ],
        series: [
          {},
          { label: 'Portfolio', stroke: accent, width: 1.75 },
          { label: 'Benchmark', stroke: muted, width: 1.25, dash: [3, 3] },
        ],
      },
      [x, portfolio.map((p) => p.nav), benchmark.map((p) => p.nav)],
      el,
    );
  }
</script>

<style>
  .equity-curve {
    margin: 0;
  }

  .empty {
    color: var(--muted);
    font-size: var(--text-sm);
    padding: var(--space-6) 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  figcaption {
    margin-top: var(--space-3);
  }

  summary {
    color: var(--muted);
    font-size: var(--text-sm);
    cursor: pointer;
  }

  summary:hover {
    color: var(--ink);
  }

  details[open] summary {
    margin-bottom: var(--space-3);
  }

  .accent {
    color: var(--accent);
  }
</style>
