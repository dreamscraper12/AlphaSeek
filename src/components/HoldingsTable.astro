---
import { formatCurrency, formatPercent, formatSignedPercent } from '../lib/format';
import type { Holding } from '../lib/data';
import { url } from '../lib/url';

interface Props {
  holdings: Holding[];
  // Home shows a compact instrument/weight/return list per the section 13
  // wireframe; /portfolio shows the full breakdown.
  compact?: boolean;
}

const { holdings, compact = false } = Astro.props;
const columnCount = compact ? 3 : 7;
---

<div class="table-scroll">
  <table class="data-table">
    <thead>
      <tr>
        <th scope="col">Instrument</th>
        {!compact && <th scope="col">Type</th>}
        <th scope="col">Weight (%)</th>
        {!compact && <th scope="col">Avg cost (A$)</th>}
        {!compact && <th scope="col">Price (A$)</th>}
        <th scope="col">Return (%)</th>
        {!compact && <th scope="col">Contribution (%)</th>}
      </tr>
    </thead>
    <tbody>
      {
        holdings.map((h) => (
          <tr>
            <td>
              {h.note_slug ? (
                <a href={url(`/research/${h.note_slug}`)}>{h.instrument_id}</a>
              ) : (
                h.instrument_id
              )}
            </td>
            {!compact && <td class="type">{h.type}</td>}
            <td class="numeric">{formatPercent(h.weight)}</td>
            {!compact && <td class="numeric">{formatCurrency(h.average_cost, 'AUD')}</td>}
            {!compact && <td class="numeric">{formatCurrency(h.price, 'AUD')}</td>}
            <td class:list={['numeric', h.return < 0 ? 'loss' : 'gain']}>
              {formatSignedPercent(h.return)}
            </td>
            {!compact && (
              <td class:list={['numeric', h.contribution < 0 ? 'loss' : 'gain']}>
                {formatSignedPercent(h.contribution)}
              </td>
            )}
          </tr>
        ))
      }
      {
        holdings.length === 0 && (
          <tr>
            <td class="empty" colspan={columnCount}>
              No open positions yet.
            </td>
          </tr>
        )
      }
    </tbody>
  </table>
</div>

<style>
  .type {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  td a {
    text-decoration-color: var(--rule);
  }
</style>
