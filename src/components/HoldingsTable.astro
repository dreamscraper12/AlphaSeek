---
import { formatCurrency, formatPercent } from '../lib/format';
import type { Holding } from '../lib/data';

interface Props {
  holdings: Holding[];
  // Home shows a compact instrument/weight/return list per the section 13
  // wireframe; /portfolio shows the full breakdown.
  compact?: boolean;
}

const { holdings, compact = false } = Astro.props;
const columnCount = compact ? 3 : 6;
---

<table class="holdings-table">
  <thead>
    <tr>
      <th scope="col">Instrument</th>
      {!compact && <th scope="col">Type</th>}
      <th scope="col">Weight</th>
      {!compact && <th scope="col">Avg cost (A$)</th>}
      {!compact && <th scope="col">Price (A$)</th>}
      <th scope="col">Return</th>
      {!compact && <th scope="col">Contribution</th>}
    </tr>
  </thead>
  <tbody>
    {
      holdings.map((h) => (
        <tr>
          <td>
            {h.note_slug ? <a href={`/research/${h.note_slug}`}>{h.instrument_id}</a> : h.instrument_id}
          </td>
          {!compact && <td>{h.type}</td>}
          <td class={h.weight < 0 ? 'loss' : ''}>{formatPercent(h.weight)}</td>
          {!compact && <td>{formatCurrency(h.average_cost, 'AUD')}</td>}
          {!compact && <td>{formatCurrency(h.price, 'AUD')}</td>}
          <td class={h.return < 0 ? 'loss' : 'gain'}>{formatPercent(h.return)}</td>
          {!compact && <td class={h.contribution < 0 ? 'loss' : 'gain'}>{formatPercent(h.contribution)}</td>}
        </tr>
      ))
    }
    {
      holdings.length === 0 && (
        <tr>
          <td colspan={columnCount}>No open positions yet.</td>
        </tr>
      )
    }
  </tbody>
</table>

<style>
  .holdings-table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  th,
  td {
    text-align: right;
    padding: 0.35rem 0.5rem;
    border-bottom: 1px solid var(--rule);
  }

  th:first-child,
  td:first-child {
    text-align: left;
  }

  .gain {
    color: var(--gain);
  }

  .loss {
    color: var(--loss);
  }
</style>
